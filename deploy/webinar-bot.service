[Unit]
Description=Telegram bot «Крутой Вебинар» + admin panel
After=network-online.target
Wants=network-online.target

[Service]
User=botuser
WorkingDirectory=/opt/webinar-bot
ExecStart=/opt/webinar-bot/.venv/bin/python -m bot
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
