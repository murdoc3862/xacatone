# Скопируйте этот файл в .env и заполните
BOT_TOKEN=123456789:ВАШ_ТОКЕН_ОТ_BOTFATHER

# Вход в админ-панель
ADMIN_LOGIN=admin
ADMIN_PASSWORD=придумайте_сложный_пароль

# Где открывается панель (127.0.0.1 = только на этом компьютере)
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Домен с HTTPS. Если задан — бот работает через webhook (на сервере).
# Оставьте пустым для локального запуска (polling).
DOMAIN=
# Секрет, которым Telegram подписывает запросы на webhook (любая строка A-Z a-z 0-9 _ -)
WEBHOOK_SECRET=
